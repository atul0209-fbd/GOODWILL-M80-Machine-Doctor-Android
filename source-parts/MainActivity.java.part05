        metric(p,"S Command • R512",String.valueOf(j.sCode));
        metric(p,"M Code • R504",String.valueOf(j.mCode));
        metric(p,"Spindle Speed RAW • R6500",String.valueOf(j.spindleSpeed));
        metric(p,"Feed Override RAW • R2500",String.valueOf(j.feedOverride));
        metric(p,"Rapid Override RAW • R2502",String.valueOf(j.rapidOverride));
        metric(p,"Spindle Override RAW • R7008",String.valueOf(j.spindleOverride));
        metric(p,"X Load RAW • R4884",String.valueOf(j.xLoad));
        metric(p,"Z Load RAW • R4888",String.valueOf(j.zLoad));
        metric(p,"Tool Change Status • R6437",String.valueOf(j.toolChangeSta